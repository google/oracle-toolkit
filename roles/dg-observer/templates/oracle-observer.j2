[Unit]
Description=Oracle Data Guard Observer Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ oracle_user }}
Group={{ oracle_group }}
ExecStart=/bin/bash -c '{{ scripts_dir }}/start_observer.sh'
ExecStop=/bin/bash -c '{{ scripts_dir }}/stop_observer.sh'
Restart=on-failure
RestartSec=10s
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target